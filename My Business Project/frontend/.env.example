# Base URL of the Laravel JSON API. The SPA calls "<VITE_API_URL>/<path>".
# Use the Vite dev proxy (leave this as /api/v1) during local development.
VITE_API_URL=/api/v1

# Backend origin used by the Vite dev server proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8100

# Public branding of the application shell.
VITE_APP_NAME=My Business
