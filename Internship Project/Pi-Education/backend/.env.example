APP_NAME=Pi-Education
APP_ENV=local
# Production: set to http(s):// your real API domain, e.g. https://api.pi-education.com
APP_URL=http://localhost:8000
# Production: set to false and run `php artisan key:generate`
APP_KEY=
APP_DEBUG=true
# Production: ALWAYS set APP_DEBUG=false. Never enable debug in production.

# Default / fallback locale (km, en, zh, fr)
APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: set to warning or error to reduce noise
LOG_LEVEL=debug

# MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pi_education
DB_USERNAME=root
# Production: use a dedicated non-root user with least privilege
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: set to your frontend domain (e.g. .pi-education.com) to share cookies

# Queue — move to redis in production for reliability; else keep database + run worker
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache — use redis in production
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis (recommended for production cache + queue)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# API rate limiting: max requests per minute per user/IP
API_RATE_LIMIT=60

# CORS — comma-separated list of allowed origins for the React SPA
# Production: set to your exact frontend origin(s), e.g. https://pi-education.com
CORS_ALLOWED_ORIGINS=*

# Sanctum / API
# Production: set to your frontend domain(s)
SANCTUM_STATEFUL_DOMAINS=localhost:5178
FRONTEND_URL=http://localhost:5178
# Sanctum bearer-token expiration in minutes (null = never). Default 60 days.
SANCTUM_TOKEN_EXPIRATION=86400

# Payment Provider Configuration (never commit real credentials)
PAYMENT_PROVIDER=mock
PAYMENT_MODE=sandbox
PAYMENT_MOCK_AUTO_APPROVE=true
# Real providers (ABA, Bakong, ACLEDA, Wing) require environment variables
# for their API keys/credentials. Add them here only AFTER you have official
# documentation and production credentials, e.g.:
# ABA_API_USERNAME=
# ABA_API_PASSWORD=
# ABA_MERCHANT_ID=

# Mail — use SMTP in production (e.g. Mailgun, SES, Postmark)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage — for production book covers/avatars use S3-compatible storage
# FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Error monitoring — e.g. Sentry (commented out until credentials available)
# SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
