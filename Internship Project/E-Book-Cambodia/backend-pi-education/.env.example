APP_NAME="Digital Library"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=digital_library
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Book storage disks. Keep local for now; switch to a cloud disk
# (e.g. 's3') defined in config/filesystems.php when migrating.
# The public disk is a symlinked, publicly addressable disk suited for covers.
BOOKS_FILE_DISK=local
BOOKS_COVER_DISK=public

QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Payment gateway: 'mock' (demo) or 'stripe' (real payments)
PAYMENT_DRIVER=mock

# VIP test mode: expose the $0.01 / 5-hour "VIP Test Card" and let it run
# through the real Bakong KHQR flow for development/testing only.
# MUST be false in production so the test card is hidden and unpurchasable.
VIP_TEST_MODE=false

# Stripe (only needed when PAYMENT_DRIVER=stripe). The webhook secret is
# REQUIRED for the /webhooks/stripe endpoint to process payments; without it
# the endpoint rejects all payloads for security.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Bakong / KHQR
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME="PI Education Cambodia"
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_CURRENCY=USD

GOOGLE_CLIENT_ID=

# AI Assistant (reader: translate, search, explain, summarize, ask).
# Driver: 'mock' (offline placeholder answers, no credentials needed),
# 'gemini' (Google Gemini) or 'openai' (any OpenAI-compatible endpoint).
# Keep API keys on the backend only; they are never sent to the browser.
# Use a vision-capable model so scanned pages can be read via OCR.
AI_DRIVER=mock
AI_ENABLED=true
AI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT=20
AI_MAX_TEXT_CHARS=12000
AI_MAX_IMAGE_BYTES=3145728
AI_TIMEOUT=30
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
