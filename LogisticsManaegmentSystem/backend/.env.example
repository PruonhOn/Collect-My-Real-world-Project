###############################################################################
# Freight Forwarding & Logistics Management System - backend environment
# Copy to .env and adjust. NEVER commit the real .env.
###############################################################################

# ---------------------------------------------------------------- Application
APP_NAME="Logistics ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Google OAuth - create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: ${APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# Resend - https://resend.com/api-keys
RESEND_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Drives demo seeding only. false = production behaviour.
APP_SEED_DEMO_DATA=true

# ------------------------------------------------------------------ Bootstrap
# The first super administrator, created by `php artisan db:seed`. Leave both
# blank in a real deployment and create the account through the deployment
# process instead - a known default password is not a password.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------ Security
# Token lifetime in minutes (default 720 = 12 hours)
SANCTUM_TOKEN_EXPIRATION=720
# Max login attempts per minute per email+ip
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60
# General API throttle
API_RATE_LIMIT=120
API_RATE_LIMIT_DECAY=1
# Minutes the role/permission cache may live in production. Kept short so a
# revoked permission cannot outlive its revocation.
PERMISSION_CACHE_TTL=5

# Leave empty for `php artisan serve`. Set to "*" or a list of IPs/CIDRs when
# running behind Nginx / Cloudflare / a load balancer, or client IPs in the
# activity log and the rate limiter will all read as the proxy.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

# --------------------------------------------------------------------- MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=logistics_erp
DB_USERNAME=root
DB_PASSWORD=root

# ------------------------------------------------------------------- Session
# Stateless API: sessions are only used by the SPA auth bootstrap route.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------------------------- Queue
# redis in production; database is a safe zero-dependency local fallback.
QUEUE_CONNECTION=redis
# QUEUE_CONNECTION=database

# -------------------------------------------------------------------- Cache
CACHE_STORE=redis
# CACHE_STORE=database

# -------------------------------------------------------------------- Redis
# predis = pure PHP. Required because ext-redis is not installed on this host.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------- Filesystem
# "documents" is a PRIVATE disk. Never exposed over the public web root.
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local
# For production S3-compatible object storage:
# DOCUMENTS_DISK=s3
# DOCUMENTS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################

# ------------------------------------------------------------------ Finance
# ISO 4217 code every amount in the system is normalised to for reporting.
BASE_CURRENCY=USD

# -------------------------------------------------------------------- Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------- Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------ Frontend
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}/api/v1"
